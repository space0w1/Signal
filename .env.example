# Copy to .env (gitignored) and fill in your key.
# docker-compose reads this automatically for variable substitution.

# Which provider generates AI summaries: "anthropic" or "gemini"
LLM_PROVIDER=anthropic

# Needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
